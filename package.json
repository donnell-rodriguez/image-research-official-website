{
  "name": "adv-medical-com-hk-tanstack-rust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:content": "python3 scripts/prepare_content.py",
    "dev": "vite --host 0.0.0.0 --port 5178",
